# Environment Variables Template
# Copy to .env and fill in your values

# API Configuration (OpenAI-compatible gateway)
API_KEY=your-api-key-here
API_BASE_URL=https://router.requesty.ai/v1

# Model Configuration
# Supported Gemini models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite, gemini-2.0-flash
# Supported OpenAI models: gpt-4o, gpt-4o-mini
DEFAULT_MODEL=gemini-2.5-flash
COORDINATOR_MODEL=gemini-2.5-flash
MAX_TOKENS=4096

# Security
ENCRYPTION_KEY=your-encryption-key-here
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.log

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_MINUTE=100000

# Performance
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
COMPRESSION_TARGET_RATIO=0.4

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
