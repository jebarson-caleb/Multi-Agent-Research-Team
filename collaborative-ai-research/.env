# Environment Variables
# Multi-model AI Gateway Configuration

# API Key
API_KEY=AIzaSyB-T97KOsBFVSPIrRoAjnew3mHxHLEJE0M

# API Provider
# Options: openai (OpenAI-compatible gateways), google_ai_studio (Gemini API), ollama (local)
API_PROVIDER=ollama

# API Base URL (set to your gateway/provider endpoint)
# Common options:
#   https://router.requesty.ai/v1  (Requesty)
#   https://openrouter.ai/api/v1   (OpenRouter)
#   https://api.openai.com/v1      (OpenAI direct)
#   https://generativelanguage.googleapis.com/v1beta  (Google AI Studio)
#   http://localhost:11434  (Ollama local)
API_BASE_URL=http://localhost:11434

# Demo mode for free-tier keys without quota
DEMO_MODE=false

# Fast mode for local LLMs (single-agent)
FAST_MODE=true

# Model Configuration
# Supported Gemini models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite, gemini-2.0-flash
# Supported OpenAI models: gpt-4o, gpt-4o-mini
# Supported local models (Ollama): llama3.1:8b, mistral:7b, qwen2.5:7b
DEFAULT_MODEL=llama3.2:3b
COORDINATOR_MODEL=llama3.2:3b
MAX_TOKENS=512

# Security
ENCRYPTION_KEY=
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.log

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_MINUTE=100000

# Performance
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
COMPRESSION_TARGET_RATIO=0.4

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
